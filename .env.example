# Copy to .env and fill real values. Never commit .env.
DB_CONNECTION=Server=localhost,1433;Database=ShopApiDb;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;
# Replace with a strong random secret (min 32 chars). Generate one with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_LONG_SECRET
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5125

# --- Docker Compose (Phase 06) ---
# SA_PASSWORD needs min 8 chars with uppercase, lowercase, digit and symbol.
SA_PASSWORD=CHANGE_ME_STRONG_8_PLUS_CHARS
DB_NAME=ShopApiDb
# Compose builds the container DB_CONNECTION from SA_PASSWORD/DB_NAME (host mssql); the localhost DB_CONNECTION above is for host-side dotnet/run only.
